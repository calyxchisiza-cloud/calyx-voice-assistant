# Server-only OpenAI credential. Never expose this as NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=sk-your-server-side-key

# Free mode brain: a free Google AI Studio key (https://aistudio.google.com/app/apikey). No credit card required.
GEMINI_API_KEY=your-free-gemini-key

# Optional: preferred Gemini model(s) for free mode, comma-separated. gemini-3.1-flash-lite is the fastest free choice.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Optional: comma-separated origins allowed to mint a session from the browser.
# Leave empty to allow same-origin requests only.
JARVIS_ALLOWED_ORIGINS=

# Optional: direct email sending ("send an email to ..."). Without these,
# CALYX can still compose an email in your mail app, but cannot send it.
# Gmail requires 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=you@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_FROM=you@gmail.com
